<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".FormLogin">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_livro_splash"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meus Livros"
                android:textColor="@color/primaria"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça login para continuar"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:layout_marginBottom="36dp" />

            <!-- Card do formulário -->
            <LinearLayout
                style="@style/ContainerComponents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edit_email_login"
                    style="@style/Edit_Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="E-mail"
                    android:inputType="textEmailAddress"
                    android:drawableEnd="@drawable/ic_email"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/texto_secundario"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/edit_senha_login"
                    style="@style/Edit_Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:drawableEnd="@drawable/ic_senha"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/texto_secundario"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/bt_entrar_login"
                    style="@style/button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Entrar" />

                <ProgressBar
                    android:id="@+id/progressbar_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/text_tela_cadastro_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="Não possui uma conta? Cadastre-se"
                    android:textColor="@color/primaria"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>