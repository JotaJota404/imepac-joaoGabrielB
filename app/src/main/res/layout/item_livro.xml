<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/fundo_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Faixa âmbar na borda esquerda -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primaria"
            android:minHeight="80dp" />

        <!-- Ícone placeholder de capa -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_book_cover"
            android:scaleType="centerInside"
            android:contentDescription="Capa do livro" />

        <!-- Textos: Título, Autor, Ano -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/text_titulo_livro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_autor_livro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_ano_livro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/primaria"
                android:textSize="11sp"
                android:alpha="0.85"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Seta de navegação -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Ver detalhes" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
