<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".TelaPerfil">

    <!-- Header âmbar decorativo -->
    <View
        android:id="@+id/view_header"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/container_components"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Container do avatar (clicável para trocar foto) -->
    <FrameLayout
        android:id="@+id/container_avatar"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="55dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Foto de perfil / avatar padrão -->
        <ImageView
            android:id="@+id/ic_person"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pessoa"
            android:tint="@color/primaria"
            android:background="@drawable/avatar_border"
            android:padding="20dp"
            android:scaleType="centerCrop"
            android:contentDescription="Foto de Perfil" />

        <!-- Badge de câmera — indica que a foto é editável -->
        <ImageView
            android:id="@+id/badge_camera"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_camera"
            android:background="@drawable/container_components"
            android:padding="4dp"
            android:contentDescription="Alterar foto" />

    </FrameLayout>

    <!-- Texto auxiliar "Toque para alterar a foto" -->
    <TextView
        android:id="@+id/text_alterar_foto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Toque para alterar a foto"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_avatar" />

    <!-- Nome do usuário -->
    <TextView
        android:id="@+id/textNomeUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nome do Usuário"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal"
        android:inputType="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_alterar_foto" />

    <!-- E-mail -->
    <TextView
        android:id="@+id/textEmailUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="email@exemplo.com"
        android:textSize="14sp"
        android:textColor="@color/texto_secundario"
        android:inputType="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textNomeUser" />

    <!-- Divisor âmbar decorativo -->
    <View
        android:id="@+id/divisor_perfil"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@color/primaria"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textEmailUser" />

    <!-- Card de informações adicionais -->
    <LinearLayout
        android:id="@+id/card_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/container_components"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divisor_perfil">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conta ativa"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Usuário autenticado com sucesso"
            android:textColor="@color/sucesso"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botão Sair (vermelho, no rodapé) -->
    <Button
        android:id="@+id/bt_sair"
        style="@style/button_perigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:text="Sair da Conta"
        android:drawableStart="@drawable/ic_logout"
        android:drawablePadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão de voltar — canto inferior esquerdo (zona de polegar) -->
    <ImageView
        android:id="@+id/bt_voltar_perfil"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/container_components"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:contentDescription="Voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
