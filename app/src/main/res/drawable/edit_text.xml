<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado: focado (digitando) -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/fundo_campo" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/primaria" />
        </shape>
    </item>

    <!-- Estado: normal -->
    <item>
        <shape>
            <solid android:color="@color/fundo_campo" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/primaria_alpha30" />
        </shape>
    </item>

</selector>