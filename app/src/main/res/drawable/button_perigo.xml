<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado: pressionado -->
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="@color/perigo_escuro"
                android:endColor="#8B2020"
                android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Estado: desabilitado -->
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/fundo_campo" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Estado: normal -->
    <item>
        <shape>
            <gradient
                android:startColor="@color/perigo"
                android:endColor="@color/perigo_escuro"
                android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
